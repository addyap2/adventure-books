{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/books",
      "destination": "/books/index.html"
    },
    {
      "source": "/books/read",
      "destination": "/books/read.html"
    },
    {
      "source": "/books/b/:slug",
      "destination": "/books/b/:slug.html"
    },
    {
      "source": "/books/read/:slug((?!.*\\.html$).*)",
      "destination": "/books/read/:slug.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "adventure-books-five.vercel.app"
        }
      ],
      "destination": "https://www.antonyaddy.com/books/:path*",
      "permanent": true
    },
    {
      "source": "/the-address",
      "destination": "https://www.antonyaddy.com/books/b/the-address",
      "permanent": true
    },
    {
      "source": "/the-address.html",
      "destination": "https://www.antonyaddy.com/books/b/the-address",
      "permanent": true
    },
    {
      "source": "/arrival",
      "destination": "https://www.antonyaddy.com/books/b/the-address",
      "permanent": true
    },
    {
      "source": "/arrival.html",
      "destination": "https://www.antonyaddy.com/books/b/the-address",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "books.antonyaddy.com"
        }
      ],
      "destination": "https://www.antonyaddy.com/books",
      "permanent": true
    },
    {
      "source": "/read/:slug.html",
      "has": [
        {
          "type": "host",
          "value": "books.antonyaddy.com"
        }
      ],
      "destination": "https://www.antonyaddy.com/books/read/:slug",
      "permanent": true
    },
    {
      "source": "/:path((?!books(?:/|$)|_vercel/).+)",
      "has": [
        {
          "type": "host",
          "value": "books.antonyaddy.com"
        }
      ],
      "destination": "https://www.antonyaddy.com/books/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.antonyaddy.com; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|webp|jpg|jpeg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
