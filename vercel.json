{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/b/:slug", "destination": "/b/:slug.html" }
  ],
  "redirects": [
    { "source": "/the-address", "destination": "/b/the-address", "permanent": true },
    { "source": "/the-address.html", "destination": "/b/the-address", "permanent": true },
    { "source": "/arrival", "destination": "/b/the-address", "permanent": true },
    { "source": "/arrival.html", "destination": "/b/the-address", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.(png|svg|webp|jpg|jpeg|ico|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
